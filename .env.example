# Copy to .env for local work. In production these live ONLY in Netlify → Site configuration → Environment variables.

# --- Telegram bot (BotFather) ---
BOT_TOKEN=                 # from BotFather /newbot
BOT_USERNAME=              # optional, e.g. trashfree_bot (saves one API call)
WEBHOOK_SECRET=            # any long random string (A-Z, a-z, 0-9, _ and -)
SETUP_SECRET=              # any long random string; open /setup?key=<this>
OWNER_TELEGRAM_IDS=        # your Telegram user id(s), comma separated (ask @userinfobot)
MINIAPP_SHORT_NAME=app     # the short name you gave in BotFather /newapp

# --- Database (Neon) ---
DATABASE_URL=              # pooled connection string (host contains "-pooler")
DATABASE_URL_UNPOOLED=     # direct connection string (used for migrations)

# --- Optional groups ---
ADMIN_SUPPORT_CHAT_ID=     # forum supergroup for support, e.g. -1001234567890
COURIER_GROUP_CHAT_ID=     # group where new orders are also posted

# --- Telegram Payments (BotFather → Payments) ---
TG_PROVIDER_TOKEN_CLICK=
TG_PROVIDER_TOKEN_PAYME=

# --- Payme Merchant API (fallback) ---
PAYME_MERCHANT_ID=
PAYME_KEY=                 # production key
PAYME_TEST_KEY=            # sandbox key

# --- Click SHOP API (fallback) ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# --- Only needed outside Netlify ---
# PUBLIC_URL=https://your-site.netlify.app
