// Trashfree database schema (Neon PostgreSQL).
// Money is always whole so'm (Int). Payme tiyin conversion happens only at the Payme boundary.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  customer
  courier
  admin
  owner
}

enum OrderStatus {
  awaiting_payment
  open
  accepted
  on_the_way
  completed
  cancelled
  expired
}

// `pending` = online order created but not yet confirmed by a provider (see README "Changes to the spec").
enum PaymentStatus {
  pending
  cod_pending
  paid
  failed
  cancelled
  subscription
}

enum PaymentMethod {
  cash
  click
  payme
  card
  subscription
}

enum PhotoKind {
  customer
  completion
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

model User {
  id                  Int       @id @default(autoincrement())
  telegramId          BigInt    @unique
  name                String
  username            String?
  phone               String?
  role                Role      @default(customer)
  language            String    @default("uz")
  blocked             Boolean   @default(false)
  blockedReason       String?
  botBlocked          Boolean   @default(false)
  mutedCategories     String[]  @default([])
  introSeen           String[]  @default([])
  nameConfirmed       Boolean   @default(false)
  deletionRequestedAt DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  courierCities     CourierCity[]
  addresses         Address[]
  orders            Order[]          @relation("CustomerOrders")
  courierOrders     Order[]          @relation("CourierOrders")
  subscriptions     Subscription[]
  notifications     Notification[]
  payments          Payment[]
  supportThread     SupportThread?
  handovers         CashHandover[]   @relation("CourierHandovers")
  confirmedHandover CashHandover[]   @relation("AdminHandovers")
  uploads           OrderPhoto[]

  @@index([role])
  @@index([phone])
}

model CourierCity {
  userId Int
  cityId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city   City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([userId, cityId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String
  address   String
  lat       Float
  lng       Float
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model City {
  id        Int     @id @default(autoincrement())
  code      String  @unique
  nameUz    String
  nameRu    String
  nameEn    String
  centerLat Float
  centerLng Float
  radiusKm  Float
  active    Boolean @default(true)
  sort      Int     @default(0)

  couriers CourierCity[]
  orders   Order[]
}

model TrashType {
  id          Int     @id @default(autoincrement())
  code        String  @unique // English code, e.g. "household" — never a translated name
  nameUz      String
  nameRu      String
  nameEn      String
  icon        String  @default("household")
  ikpu        String? // MXIK code for fiscal receipts
  packageCode String? // package (unit) code for fiscal receipts
  vatPercent  Int     @default(0)
  active      Boolean @default(true)
  sort        Int     @default(0)

  prices PriceRule[]
  orders Order[]
}

model PackageSize {
  id     Int     @id @default(autoincrement())
  code   String  @unique // small | medium | large
  nameUz String
  nameRu String
  nameEn String
  liters Int     @default(60)
  active Boolean @default(true)
  sort   Int     @default(0)

  prices PriceRule[]
  orders Order[]
}

model PriceRule {
  id            Int         @id @default(autoincrement())
  trashTypeId   Int
  packageSizeId Int
  firstPrice    Int
  extraPrice    Int
  trashType     TrashType   @relation(fields: [trashTypeId], references: [id], onDelete: Cascade)
  packageSize   PackageSize @relation(fields: [packageSizeId], references: [id], onDelete: Cascade)

  @@unique([trashTypeId, packageSizeId])
}

model TimeSlot {
  id          Int     @id @default(autoincrement())
  startMinute Int // minutes from midnight, Tashkent time
  endMinute   Int
  capacity    Int? // null = unlimited
  priority    Boolean @default(false) // subscribers only (when enabled in settings)
  active      Boolean @default(true)

  orders Order[]
}

model Order {
  id              String        @id @default(cuid())
  number          Int           @unique @default(autoincrement())
  customerId      Int
  cityId          Int
  address         String
  lat             Float?
  lng             Float?
  notes           String?
  trashTypeId     Int
  packageSizeId   Int
  quantity        Int
  pickupDate      String // YYYY-MM-DD in Tashkent
  slotId          Int
  priceTotal      Int
  priceBreakdown  Json
  status          OrderStatus
  paymentStatus   PaymentStatus
  paymentMethod   PaymentMethod
  idempotencyKey  String        @unique
  courierId       Int?
  acceptedAt      DateTime?
  onTheWayAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cashCollected   Int?
  cashHandoverId  Int?
  rating          Int?
  ratingComment   String?
  ratingAskedAt   DateTime?
  cancelReason    String?
  cancelledBy     String? // customer | admin | system
  expiresAt       DateTime?
  subscriptionId  Int?
  courierGroupMsg Int?
  refundNote      String?
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer     User          @relation("CustomerOrders", fields: [customerId], references: [id])
  courier      User?         @relation("CourierOrders", fields: [courierId], references: [id])
  city         City          @relation(fields: [cityId], references: [id])
  trashType    TrashType     @relation(fields: [trashTypeId], references: [id])
  packageSize  PackageSize   @relation(fields: [packageSizeId], references: [id])
  slot         TimeSlot      @relation(fields: [slotId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  cashHandover CashHandover? @relation(fields: [cashHandoverId], references: [id])
  photos       OrderPhoto[]
  payments     Payment[]

  @@index([status, cityId])
  @@index([customerId, createdAt])
  @@index([courierId, status])
  @@index([pickupDate, slotId])
  @@index([createdAt])
}

model OrderPhoto {
  id         String    @id @default(cuid())
  orderId    String?
  uploaderId Int
  kind       PhotoKind
  blobKey    String    @unique
  mime       String
  size       Int
  createdAt  DateTime  @default(now())
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploader   User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model Payment {
  id               String        @id @default(cuid())
  userId           Int
  orderId          String?
  subscriptionId   Int?
  provider         String // telegram_click | telegram_payme | payme | click | manual
  method           PaymentMethod
  providerTxId     String?       @unique // prefixed: "payme:<id>", "click:<id>", "tg:<charge id>"
  amount           Int // so'm
  status           String        @default("created") // created | pending | paid | cancelled | failed
  state            Int? // Payme transaction state (1, 2, -1, -2)
  reason           Int? // Payme cancel reason
  createTime       BigInt? // Payme ms timestamps
  performTime      BigInt?
  cancelTime       BigInt?
  clickPrepareId   Int?          @unique @default(autoincrement())
  rawCallback      Json[]        @default([])
  receiptNo        String?       @unique
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id])
  order            Order?        @relation(fields: [orderId], references: [id])
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([orderId])
  @@index([subscriptionId])
  @@index([userId, createdAt])
}

model SubscriptionPlan {
  id           Int     @id @default(autoincrement())
  code         String  @unique // start | business | professional
  nameUz       String
  nameRu       String
  nameEn       String
  pickups      Int
  price        Int
  durationDays Int     @default(30)
  active       Boolean @default(true)
  sort         Int     @default(0)

  subscriptions Subscription[]
}

model Subscription {
  id           Int                @id @default(autoincrement())
  userId       Int
  planId       Int
  periodStart  DateTime?
  periodEnd    DateTime?
  pickupsTotal Int
  pickupsUsed  Int                @default(0)
  status       SubscriptionStatus @default(pending)
  reminded3d   Boolean            @default(false)
  remindedDay  Boolean            @default(false)
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan   @relation(fields: [planId], references: [id])
  orders       Order[]
  payments     Payment[]

  @@index([userId, status])
}

model CashHandover {
  id            Int      @id @default(autoincrement())
  courierId     Int
  amount        Int
  confirmedById Int
  note          String?
  createdAt     DateTime @default(now())
  courier       User     @relation("CourierHandovers", fields: [courierId], references: [id])
  confirmedBy   User     @relation("AdminHandovers", fields: [confirmedById], references: [id])
  orders        Order[]
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  payload   Json
  dedupKey  String?
  delivery  String? // sent | muted | blocked | failed: <reason> — what happened to the bot message
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupKey])
  @@index([userId, createdAt])
}

model SupportThread {
  id            Int              @id @default(autoincrement())
  userId        Int              @unique
  topicId       Int
  cardMessageId Int?
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      SupportMessage[]

  @@index([topicId])
}

model SupportMessage {
  id        Int           @id @default(autoincrement())
  threadId  Int
  direction String // in | out
  text      String?
  hasPhoto  Boolean       @default(false)
  createdAt DateTime      @default(now())
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Broadcast {
  id          Int                 @id @default(autoincrement())
  createdById Int
  title       String
  text        String
  button      String? // deep-link screen, e.g. "plans"
  audience    String // all | customers | couriers | city
  cityId      Int?
  status      String              @default("draft") // draft | sending | done
  total       Int                 @default(0)
  sent        Int                 @default(0)
  failed      Int                 @default(0)
  blocked     Int                 @default(0)
  createdAt   DateTime            @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  deliveries  BroadcastDelivery[]
}

model BroadcastDelivery {
  id          Int       @id @default(autoincrement())
  broadcastId Int
  userId      Int
  status      String    @default("queued") // queued | sent | failed | blocked
  error       String?
  sentAt      DateTime?
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([broadcastId, status])
}

model Invite {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  cityIds     Int[]
  createdById Int
  usedById    Int?
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model ProcessedUpdate {
  updateId  BigInt   @id
  createdAt DateTime @default(now())
}

model SchedulerRun {
  id         Int       @id @default(autoincrement())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  info       Json?

  @@index([job, startedAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model GeocodeCache {
  key       String   @id // "lat,lng,lang" rounded
  address   String
  createdAt DateTime @default(now())
}

model RateCounter {
  key     String   @id
  count   Int
  resetAt DateTime
}
